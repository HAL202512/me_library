<%= form_with model: memory_form, url: url, method: method, local: true do |f| %>
  <% if memory_form.errors.any? %>
    <div class="bg-red-100 text-red-700 p-4 mb-4 rounded">
      <ul class="list-disc pl-5">
        <% memory_form.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-4">
    <%= f.label :title, "作品名", class: "block font-bold mb-2" %>
    <%= f.text_field :title, class: "border rounded p-2 w-full" %>
  </div>

  <div class="mb-4">
    <%= f.label :author, "作者名", class: "block font-bold mb-2" %>
    <%= f.text_field :author, class: "border rounded p-2 w-full" %>
  </div>

  <div class="mb-4">
    <%= f.label :genre, "ジャンル", class: "block font-bold mb-2" %>
    <%= f.select :genre, ["小説", "ビジネス書", "自己啓発", "技術書", "映画", "アニメ", "その他"], { include_blank: "選択してください" }, class: "border rounded p-2 w-full" %>
  </div>

  <div class="mb-4">
    <%= f.label :encountered_year, "出会った年", class: "block font-bold mb-2" %>
    <%= f.number_field :encountered_year, class: "border rounded p-2 w-full", min: 1900, max: Date.today.year %>
  </div>

  <div class="mb-6">
    <%= f.label :content, "当時の思い出", class: "block font-bold mb-2" %>
    <%= f.text_area :content, rows: 5, class: "border rounded p-2 w-full" %>
  </div>

  <!-- タグ選択エリア -->
  <div class="mb-6">
    <p class="block font-bold mb-2">タグ（複数選択可）</p>
    <div class="flex flex-wrap gap-4">
      <!-- 感情タグ -->
      <div class="border p-3 rounded w-full md:w-auto bg-white">
        <p class="text-sm text-gray-500 font-bold mb-2">感情</p>
        <div class="flex flex-wrap gap-2">
          <%= f.collection_check_boxes :tag_ids, Tag.emotion, :id, :name do |b| %>
            <div class="inline-flex items-center">
              <%= b.check_box class: "mr-1" %>
              <%= b.label class: "text-sm mr-3" %>
            </div>
          <% end %>
        </div>
      </div>
      <!-- 価値観タグ -->
      <div class="border p-3 rounded w-full md:w-auto bg-white">
        <p class="text-sm text-gray-500 font-bold mb-2">価値観</p>
        <div class="flex flex-wrap gap-2">
          <%= f.collection_check_boxes :tag_ids, Tag.value, :id, :name do |b| %>
            <div class="inline-flex items-center">
              <%= b.check_box class: "mr-1" %>
              <%= b.label class: "text-sm mr-3" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div>
    <%= f.submit submit_text, class: "bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded cursor-pointer" %>
    <%= link_to "キャンセル", root_path, class: "ml-4 text-blue-500 hover:underline" %>
  </div>
<% end %>