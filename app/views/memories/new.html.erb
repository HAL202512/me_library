<div class="max-w-2xl mx-auto mt-10">
  <h1 class="text-2xl font-bold mb-6">思い出を記録する</h1>

  <%= form_with model: @memory_form, url: memories_path, local: true do |f| %>
    <% if @memory_form.errors.any? %>
      <div class="bg-red-100 text-red-700 p-4 mb-4 rounded">
        <ul class="list-disc pl-5">
          <% @memory_form.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-4">
      <%= f.label :genre, "作品ジャンル", class: "block font-bold mb-2" %>
      <!-- ジャンルはMVPの要件に合わせて適宜変更してください -->
      <%= f.select :genre, ["小説", "映画", "アニメ", "漫画", "その他"], { include_blank: "選択してください" }, class: "border rounded p-2 w-full" %>
    </div>

    <div class="mb-4">
      <%= f.label :title, "作品タイトル", class: "block font-bold mb-2" %>
      <%= f.text_field :title, class: "border rounded p-2 w-full" %>
    </div>

    <div class="mb-4">
      <%= f.label :author, "作者", class: "block font-bold mb-2" %>
      <%= f.text_field :author, class: "border rounded p-2 w-full" %>
    </div>

    <div class="mb-4">
      <%= f.label :encountered_year, "出会い（年）", class: "block font-bold mb-2" %>
      <%= f.number_field :encountered_year, class: "border rounded p-2 w-full" %>
    </div>

    <div class="mb-6">
      <%= f.label :content, "当時の思い出・体験", class: "block font-bold mb-2" %>
      <%= f.text_area :content, rows: 5, class: "border rounded p-2 w-full" %>
    </div>

    <div>
      <%= f.submit "保存", class: "bg-blue-500 text-white font-bold py-2 px-4 rounded cursor-pointer" %>
    </div>
  <% end %>
</div>