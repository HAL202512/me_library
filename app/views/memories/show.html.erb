<div class="max-w-3xl mx-auto mt-8">
  
  <!-- 戻るリンク -->
  <div class="mb-4">
    <%= link_to "← 一覧に戻る", root_path, class: "text-gray-500 hover:text-gray-700 text-sm font-bold" %>
  </div>

  <div class="mb-8 p-6 pt-0 bg-white rounded-lg shadow-sm border border-gray-200">
    
    <!-- 1. 作品情報ヘッダー (スクロール追従) -->
    <div class="sticky top-16 z-30 bg-white/95 backdrop-blur-sm border-b pb-4 mb-6 pt-6 -mx-6 px-6 flex flex-col sm:flex-row sm:justify-between sm:items-start gap-4">
      <div>
        <h1 class="text-2xl font-bold text-gray-800"><%= @memory.work.title %></h1>
        <p class="text-gray-500 mt-2">
          作者: <%= @memory.work.author %> | ジャンル: <%= @memory.work.genre %>
        </p>
      </div>
      
      <!-- アクションボタン群 -->
      <div class="flex flex-wrap items-center gap-2 mt-2 sm:mt-0">
        <%= link_to "＋ 振り返りを記録", new_memory_reflection_path(@memory), class: "bg-green-500 hover:bg-green-600 text-white text-sm font-bold py-1.5 px-3 rounded shadow-sm" %>
        <%= link_to "編集", edit_memory_path(@memory), class: "text-gray-600 hover:text-blue-600 text-sm font-bold bg-white px-3 py-1.5 rounded border shadow-sm" %>
        <%= button_to "削除", memory_path(@memory), method: :delete, onclick: "return confirm('思い出と振り返りがすべて削除されます。本当によろしいですか？');", class: "text-gray-600 hover:text-red-600 text-sm font-bold bg-white px-3 py-1.5 rounded border shadow-sm" %>
      </div>
    </div>

    <!-- 2. タイムライン表示エリア -->
    <div class="p-6">
      <div class="relative border-l-2 border-blue-200 ml-4 py-2 space-y-8">
        
        <!-- 【始点】当時の思い出 -->
        <div class="relative pl-6">
          <div class="absolute -left-[9px] top-1.5 w-4 h-4 bg-blue-500 rounded-full border-2 border-white"></div>
          
          <p class="text-sm text-blue-600 font-bold mb-3"><%= @memory.encountered_year %>年の出会い</p>
          
          <!-- 原体験のタグ表示 -->
          <% if @memory.tags.any? %>
            <div class="mb-4 space-y-3">
              <% emotions = @memory.tags.select { |t| t.category == 'emotion' } %>
              <% if emotions.any? %>
                <div>
                  <p class="text-xs text-gray-500 font-bold mb-1.5">当時の感情</p>
                  <div class="flex flex-wrap gap-1.5">
                    <% emotions.each do |tag| %>
                      <% colors = tag_color_classes(tag.name) %>
                      <span class="inline-block text-xs px-2.5 py-1 rounded-full border <%= colors[:base] %>"><%= tag.name %></span>
                    <% end %>
                  </div>
                </div>
              <% end %>
              
              <% values = @memory.tags.select { |t| t.category == 'value' } %>
              <% if values.any? %>
                <div>
                  <p class="text-xs text-gray-500 font-bold mb-1.5">当時の価値観</p>
                  <div class="flex flex-wrap gap-1.5">
                    <% values.each do |tag| %>
                      <% colors = tag_color_classes(tag.name) %>
                      <span class="inline-block text-xs px-2.5 py-1 rounded-full border <%= colors[:base] %>"><%= tag.name %></span>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>

          <!-- 本文（続きを読むUI） -->
          <div class="p-4 bg-blue-50 rounded border border-blue-100">
            <% if @memory.content.length > 150 || @memory.content.count("\n") > 2 %>
              <input type="checkbox" id="read-more-memory" class="peer hidden">
              
              <!-- プレビュー表示 -->
              <div class="text-sm text-gray-700 whitespace-pre-wrap break-words break-all line-clamp-3 peer-checked:hidden"><%= @memory.content %></div>
              
              <!-- 全文表示 -->
              <div class="text-sm text-gray-700 whitespace-pre-wrap break-words break-all hidden peer-checked:block"><%= @memory.content %></div>
              
              <label for="read-more-memory" class="text-blue-500 hover:text-blue-700 text-xs font-bold cursor-pointer mt-2 inline-block peer-checked:hidden">
                続きを読む ▼
              </label>
              <label for="read-more-memory" class="text-blue-500 hover:text-blue-700 text-xs font-bold cursor-pointer mt-2 hidden peer-checked:inline-block">
                閉じる ▲
              </label>
            <% else %>
              <div class="text-sm text-gray-700 whitespace-pre-wrap break-words break-all"><%= @memory.content %></div>
            <% end %>
          </div>

        <!-- 【経過】振り返りの履歴 -->
        <% @memory.reflections.sort_by(&:recorded_on).each do |reflection| %>
          <div class="relative pl-6">
            <div class="absolute -left-[9px] top-1.5 w-4 h-4 bg-green-500 rounded-full border-2 border-white"></div>
            
            <p class="text-sm text-green-600 font-bold mb-3"><%= reflection.recorded_on.strftime("%Y年%m月%d日") %> の振り返り</p>
            
            <!-- 振り返りのタグ表示 -->
            <% if reflection.tags.any? %>
              <div class="mb-4 space-y-3">
                <% emotions = reflection.tags.select { |t| t.category == 'emotion' } %>
                <% if emotions.any? %>
                  <div>
                    <p class="text-xs text-gray-500 font-bold mb-1.5">当時の感情</p>
                    <div class="flex flex-wrap gap-1.5">
                      <% emotions.each do |tag| %>
                        <% colors = tag_color_classes(tag.name) %>
                        <span class="inline-block text-xs px-2.5 py-1 rounded-full border <%= colors[:base] %>"><%= tag.name %></span>
                      <% end %>
                    </div>
                  </div>
                <% end %>

                <% values = reflection.tags.select { |t| t.category == 'value' } %>
                <% if values.any? %>
                  <div>
                    <p class="text-xs text-gray-500 font-bold mb-1.5">当時の価値観</p>
                    <div class="flex flex-wrap gap-1.5">
                      <% values.each do |tag| %>
                        <% colors = tag_color_classes(tag.name) %>
                        <span class="inline-block text-xs px-2.5 py-1 rounded-full border <%= colors[:base] %>"><%= tag.name %></span>
                      <% end %>
                    </div>
                  </div>
                <% end %>

                <% reflections = reflection.tags.select { |t| t.category == 'reflection' } %>
                <% if reflections.any? %>
                  <div>
                    <p class="text-xs text-gray-500 font-bold mb-1.5">自己の変化</p>
                    <div class="flex flex-wrap gap-1.5">
                      <% reflections.each do |tag| %>
                        <% colors = tag_color_classes(tag.name) %>
                        <span class="inline-block text-xs px-2.5 py-1 rounded-full border <%= colors[:base] %>"><%= tag.name %></span>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>
            
            <!-- 本文（続きを読むUI） -->
            <div class="p-4 bg-gray-50 rounded border border-gray-200">
              <% if reflection.content.length > 150 || reflection.content.count("\n") > 2 %>
                <input type="checkbox" id="read-more-reflection-<%= reflection.id %>" class="peer hidden">
                
                <!-- プレビュー表示 -->
                <div class="text-sm text-gray-700 whitespace-pre-wrap break-words break-all line-clamp-3 peer-checked:hidden"><%= reflection.content %></div>
                
                <!-- 全文表示 -->
                <div class="text-sm text-gray-700 whitespace-pre-wrap break-words break-all hidden peer-checked:block"><%= reflection.content %></div>
                
                <label for="read-more-reflection-<%= reflection.id %>" class="text-green-500 hover:text-green-700 text-xs font-bold cursor-pointer mt-2 inline-block peer-checked:hidden">
                  続きを読む ▼
                </label>
                <label for="read-more-reflection-<%= reflection.id %>" class="text-green-500 hover:text-green-700 text-xs font-bold cursor-pointer mt-2 hidden peer-checked:inline-block">
                  閉じる ▲
                </label>
              <% else %>
                <div class="text-sm text-gray-700 whitespace-pre-wrap break-words break-all"><%= reflection.content %></div>
              <% end %>
            </div>
        
            <!-- 振り返りの編集・削除ボタン -->
            <div class="mt-3 flex justify-end gap-3 items-center">
              <%= link_to "編集", edit_memory_reflection_path(@memory, reflection), class: "text-blue-500 hover:text-blue-700 text-sm font-bold" %>
              <%= button_to "削除", memory_reflection_path(@memory, reflection), method: :delete, onclick: "return confirm('本当に削除しますか？');", class: "text-red-500 hover:text-red-700 text-sm font-bold", form: { class: "inline-block" } %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

  </div>
</div>
