<div class="max-w-2xl mx-auto mt-10">
  <h1 class="text-2xl font-bold mb-6">思い出の編集</h1>

  <%= form_with model: @memory_form, url: memory_path(@memory), method: :patch, local: true do |f| %>
    <% if @memory_form.errors.any? %>
      <div class="bg-red-100 text-red-700 p-4 mb-4 rounded">
        <ul class="list-disc pl-5">
          <% @memory_form.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-4">
      <%= f.label :title, "作品名", class: "block font-bold mb-2" %>
      <%= f.text_field :title, class: "border rounded p-2 w-full" %>
    </div>

    <div class="mb-4">
      <%= f.label :author, "作者名 (任意)", class: "block font-bold mb-2" %>
      <%= f.text_field :author, class: "border rounded p-2 w-full" %>
    </div>

    <div class="mb-4">
      <%= f.label :genre, "ジャンル", class: "block font-bold mb-2" %>
      <%= f.select :genre, ["小説", "ビジネス書", "自己啓発", "技術書", "その他"], { include_blank: "選択してください" }, class: "border rounded p-2 w-full" %>
    </div>

    <div class="mb-4">
      <%= f.label :encountered_year, "出会った年", class: "block font-bold mb-2" %>
      <%= f.number_field :encountered_year, class: "border rounded p-2 w-full", min: 1900, max: Date.today.year %>
    </div>

    <div class="mb-6">
      <%= f.label :content, "当時の思い出", class: "block font-bold mb-2" %>
      <%= f.text_area :content, rows: 5, class: "border rounded p-2 w-full" %>
    </div>

    <div>
      <%= f.submit "更新する", class: "bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded cursor-pointer" %>
      <%= link_to "キャンセル", root_path, class: "ml-4 text-blue-500 hover:underline" %>
    </div>
  <% end %>
</div>