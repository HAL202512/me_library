<%= form_with model: [@memory, reflection], local: true do |f| %>
  <% if reflection.errors.any? %>
    <div class="bg-red-100 text-red-700 p-4 mb-4 rounded">
      <ul class="list-disc pl-5">
        <% reflection.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-4">
    <%= f.label :recorded_on, "記録日：", class: "block font-bold mb-2" %>
    <%= f.date_field :recorded_on, class: "border rounded p-2" %>
  </div>

  <div class="mb-6">
    <%= f.label :content, "改めて振り返ったときに感じたことや・変化したこと", class: "block font-bold mb-2" %>
    <%= f.text_area :content, rows: 5, class: "border rounded p-2 w-full" %>
  </div>

<!-- タグ選択エリア -->
  <div class="mb-6">
    <p class="block font-bold mb-2">タグ（複数選択可）</p>
    <div class="flex flex-wrap gap-4">
      <!-- 感情タグ -->
      <div class="border p-3 rounded w-full md:w-auto bg-white">
        <p class="text-sm text-gray-500 font-bold mb-2">感情</p>
        <div class="flex flex-wrap gap-2">
          <%= f.collection_check_boxes :tag_ids, Tag.emotion, :id, :name do |b| %>
            <div class="inline-flex items-center">
              <%= b.check_box class: "mr-1" %>
              <%= b.label class: "text-sm mr-3" %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- 価値観タグ -->
      <div class="border p-3 rounded w-full md:w-auto bg-white">
        <p class="text-sm text-gray-500 font-bold mb-2">価値観</p>
        <div class="flex flex-wrap gap-2">
          <%= f.collection_check_boxes :tag_ids, Tag.value, :id, :name do |b| %>
            <div class="inline-flex items-center">
              <%= b.check_box class: "mr-1" %>
              <%= b.label class: "text-sm mr-3" %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- 振り返りタグ -->
      <div class="border p-3 rounded w-full md:w-auto bg-white">
        <p class="text-sm text-gray-500 font-bold mb-2">振り返り</p>
        <div class="flex flex-wrap gap-2">
          <%= f.collection_check_boxes :tag_ids, Tag.reflection, :id, :name do |b| %>
            <div class="inline-flex items-center">
              <%= b.check_box class: "mr-1" %>
              <%= b.label class: "text-sm mr-3" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div>
    <%= f.submit submit_text, class: "bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded cursor-pointer" %>
    <%= link_to "キャンセル", memory_path(@memory), class: "ml-4 text-blue-500 hover:underline" %>
  </div>
<% end %>