<div class="max-w-md mx-auto mt-10 p-6 bg-white border rounded-lg shadow-sm">
  <h1 class="text-2xl font-bold mb-6 text-center">ログイン</h1>

  <!-- ログインは特定のモデルに紐づかないため url を指定します -->
  <%= form_with url: user_sessions_path, local: true do |f| %>
    <div class="mb-4">
      <%= f.label :email, "Email", class: "block font-bold mb-2" %>
      <%= f.email_field :email, class: "border rounded p-2 w-full" %>
    </div>

    <div class="mb-6">
      <%= f.label :password, "パスワード", class: "block font-bold mb-2" %>
      <%= f.password_field :password, class: "border rounded p-2 w-full" %>
    </div>

    <div>
      <%= f.submit "ログイン", class: "bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded w-full cursor-pointer" %>
    </div>
  <% end %>

  <div class="mt-6 text-center">
    <%= link_to "新規登録", new_user_path, class: "text-blue-500 hover:underline text-sm" %>
  </div>
</div>