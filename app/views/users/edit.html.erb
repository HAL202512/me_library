<div class="max-w-md mx-auto mt-10 p-6 bg-white border rounded-lg shadow-sm">
  <h2 class="text-2xl font-bold mb-6 text-gray-800">アカウント設定</h2>

  <%= form_with model: @user, local: true do |f| %>
    
    <% if @user.errors.any? %>
      <div class="bg-red-100 text-red-700 p-4 mb-4 rounded text-sm">
        <ul class="list-disc pl-5">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-4">
      <%= f.label :name, "アカウント名", class: "block font-bold mb-2 text-sm text-gray-700" %>
      <%= f.text_field :name, autofocus: true, class: "border rounded p-2 w-full focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>

    <div class="mb-4">
      <%= f.label :email, "メールアドレス", class: "block font-bold mb-2 text-sm text-gray-700" %>
      <%= f.email_field :email, class: "border rounded p-2 w-full focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>

    <div class="mb-4 border-t pt-4 mt-6">
      <%= f.label :password, "新しいパスワード", class: "block font-bold mb-2 text-sm text-gray-700" %>
      <p class="text-xs text-gray-500 mb-2">※変更しない場合は空欄のままにしてください</p>
      <%= f.password_field :password, class: "border rounded p-2 w-full focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>

    <div class="mb-6">
      <%= f.label :password_confirmation, "新しいパスワード（確認用）", class: "block font-bold mb-2 text-sm text-gray-700" %>
      <%= f.password_field :password_confirmation, class: "border rounded p-2 w-full focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>

    <div class="actions">
      <%= f.submit "更新する", class: "w-full bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded cursor-pointer shadow-sm" %>
    </div>
  <% end %>
</div>