<!DOCTYPE html>
<html>
  <head>
    <title>思い出図書館</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>

  <body class="bg-gray-50 text-gray-900">
    <!-- 共通ヘッダー -->
    <header class="bg-white border-b shadow-sm sticky top-0 z-50">
      <div class="max-w-5xl mx-auto px-4 h-16 flex justify-between items-center">
        
        <!-- ロゴ（ホームへのリンク） -->
        <%= link_to root_path, class: "flex items-center gap-2 text-xl font-bold text-gray-800 hover:text-blue-600 transition-colors" do %>
          <svg class="w-6 h-6 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
          </svg>
          思い出図書館
        <% end %>

        <!-- 右側のメニュー（ログイン時のみ表示） -->
        <% if current_user %>
          <div class="flex items-center gap-6">
            
            <!-- 新規作品登録ボタン -->
            <%= link_to new_memory_path, class: "flex items-center gap-1 text-sm font-bold text-white bg-blue-500 hover:bg-blue-600 px-4 py-2 rounded shadow transition-colors" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
              新規作品登録
            <% end %>

            <!-- アカウントのプルダウンメニュー -->
            <div class="relative group">
              <button class="flex items-center gap-1 text-sm font-bold text-gray-700 hover:text-blue-600 focus:outline-none py-2">
                <%= current_user.try(:name).presence || current_user.email %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </button>
              
              <div class="absolute right-0 mt-0 w-48 bg-white border rounded shadow-lg hidden group-hover:block">
                <div class="py-1">
                  <%= link_to "アカウント設定", edit_user_path(current_user), class: "block px-4 py-2 text-sm text-gray-700 hover:bg-blue-50 hover:text-blue-600" %>
                  <div class="border-t my-1"></div>
                  <%= button_to "ログアウト", user_session_path, method: :delete, class: "block w-full text-left px-4 py-2 text-sm text-red-600 hover:bg-red-50" %>
                </div>
              </div>
            </div>

          </div>
        <% else %>
          <!-- 未ログイン時のメニュー -->
          <div class="flex items-center gap-4">
            <%= link_to "ログイン", new_user_session_path, class: "text-sm font-bold text-gray-700 hover:text-blue-600" %>
            <%= link_to "新規登録", new_user_path, class: "text-sm font-bold text-white bg-blue-500 hover:bg-blue-600 px-4 py-2 rounded shadow" %>
          </div>
        <% end %>
      </div>
    </header>

    <!-- メインコンテンツ -->
    <main class="py-8 px-4">
      <% flash.each do |key, message| %>
        <div class="max-w-4xl mx-auto mb-4 p-4 rounded <%= key == 'notice' ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %>">
          <%= message %>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>